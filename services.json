{
  "mobile-api": {
    "enabled": true,
    "build_kind": "java21",
    "source_repository": "KairosApplication/kairos-springboot",
    "namespace": "kairos-mobile-api",
    "release": "mobile-api",
    "ecr_repository": "kairos/mobile-api",
    "values": "environments/production/mobile-api.yaml",
    "fallback_dockerfile": "examples/mobile-api/Dockerfile",
    "maven_test_profile": "postgres-tests"
  },
  "agent-api": {
    "enabled": true,
    "build_kind": "java21",
    "source_repository": "KairosApplication/kairos-api-ia",
    "namespace": "kairos-agent-api",
    "release": "agent-api",
    "ecr_repository": "kairos/agent-api",
    "values": "environments/production/agent-api.yaml",
    "fallback_dockerfile": "examples/agent-api/Dockerfile"
  },
  "redis-api": {
    "enabled": true,
    "build_kind": "python312",
    "source_repository": "KairosApplication/kairos-data",
    "source_path": "redis",
    "namespace": "kairos-redis-api",
    "release": "redis-api",
    "ecr_repository": "kairos/redis-api",
    "values": "environments/production/redis-api.yaml",
    "fallback_dockerfile": "examples/redis-api/Dockerfile"
  }
}
